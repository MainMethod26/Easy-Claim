        {
            "name": "3. Claims Wizard (6-Stage Flow)",
            "item": [
                {
                    "name": "Step 1: Initiate (Category)",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/initiate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "initiate"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.claimId) {",
                                    "    pm.collectionVariables.set(\"claimId\", jsonData.claimId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Step 2: Verification Check",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/verify-eligibility",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "verify-eligibility"
                            ]
                        }
                    }
                },
                {
                    "name": "Step 3: Screening Context",
                    "request": {
                        "method": "PATCH",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/screening",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "{{claimId}}",
                                "screening"
                            ]
                        }
                    }
                },
                {
                    "name": "Step 4: Evidence Upload (OCR)",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/evidence-ocr",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "{{claimId}}",
                                "evidence-ocr"
                            ]
                        }
                    }
                },
                {
                    "name": "Step 5: Submit for Review",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/submit",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "{{claimId}}",
                                "submit"
                            ]
                        }
                    }
                },
                {
                    "name": "Step 6: Status Timeline",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/claims/{{claimId}}/timeline",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "claims",
                                "{{claimId}}",
                                "timeline"
                            ]
                        }
                    }
                }
            ]
        },
